# Copy this file to .env and fill in your own values.

# Port the API listens on
PORT=5050

# Website address allowed to call the API (the React dev server by default)
FRONTEND_ORIGIN=http://localhost:5173

# Admin panel login (open /admin on the website)
# Use a long password you don't use anywhere else.
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign admin login sessions. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Where the database file is stored
DB_PATH=./data/cottage.db

# --- Optional: email alerts for new bookings and messages ---
# Leave SMTP_HOST empty to turn email alerts off.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=your Gmail address, SMTP_PASS=an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
